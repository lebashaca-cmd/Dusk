# Copy this file to .env and fill it in.

# --- Discord login (https://discord.com/developers/applications) ---
# 1. Create an application, open OAuth2, copy the Client ID and Client Secret.
# 2. Under OAuth2 > Redirects add the redirect URI below (it must match exactly).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# While developing with `npm run dev` the browser talks to Vite on :5173,
# which proxies /auth to the server, so use this redirect:
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback
# In production use your real domain, for example:
# DISCORD_REDIRECT_URI=https://yourdomain.com/auth/discord/callback

# --- Server ---
PORT=3000
# Public URL of the site (used for cookies and links). No trailing slash.
BASE_URL=http://localhost:5173
# Any long random string. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Where the database and uploaded files live.
DATA_DIR=data
# Set to 1 when running behind a reverse proxy (nginx, Caddy, a host's load balancer).
TRUST_PROXY=0

# Local testing only: set to 1 to enable /auth/dev, which logs you in as a
# throwaway test account without Discord. Ignored when NODE_ENV=production.
DEV_LOGIN=0

# --- Discord server (roles shown as tags, and people must join it to log in) ---
# Leave these empty to skip the requirement (no roles are shown then).
# 1. In the Discord app: Settings > Advanced > Developer Mode on. Right-click your server > Copy Server ID.
# 2. Developer Portal > your application > Bot > Reset Token, copy it. Invite the bot to your server
#    (OAuth2 > URL Generator > scope "bot", no permissions needed). Put the bot's role anywhere; it only reads roles.
# 3. Create a permanent invite link in the server so people can join.
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
DISCORD_INVITE_URL=

# --- Supabase (optional: keeps the database and uploads off the host's disk) ---
# Run supabase/setup.sql in the Supabase SQL Editor first.
# Project Settings > API: copy the Project URL and the secret (service_role) key. Never put the secret key in the web app.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=dusk

# --- Sign-up log (used by the bot's /dusklogs command, see bot/dusklogs.js) ---
# A long random value (24+ characters). The bot sends it as a bearer token. Leave empty to switch the log API off.
DUSK_ADMIN_TOKEN=

# --- Owners and devs: more than one page ---
# Everyone gets one page. These people can create more (up to DUSK_MAX_PAGES).
# Comma-separated Discord user IDs (Developer Mode > right-click yourself > Copy User ID):
DUSK_OWNER_IDS=
DUSK_DEV_IDS=
# ...and/or anyone who has one of these roles in your Discord server (needs DISCORD_GUILD_ID and DISCORD_BOT_TOKEN):
DUSK_PAGE_ROLES=owner,dev,developer
DUSK_MAX_PAGES=10

# Where "Risk" in the footer credit ("Provided By Risk") links. Leave empty to use DISCORD_INVITE_URL.
DUSK_CREDIT_URL=
